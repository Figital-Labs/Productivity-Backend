// Prisma schema — see .agents/ARCHITECTURE.md for the design.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("staff")
  orgId        String
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Sprint 11: Task ownership split — assigneeId is who does the work,
  // creatorId is who created/delegated. For self-created tasks they're equal.
  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  // Sprint 11: M2M self-relation for matrix hospital authority.
  // A staff nurse can have multiple managers (Head Nurse + Attending Doctor)
  // and a manager can have multiple reports. Declared as Prisma implicit M2M;
  // join table `_UserHierarchy` has columns A (manager) and B (report).
  reports  User[] @relation("UserHierarchy")
  managers User[] @relation("UserHierarchy")

  notes                Note[]
  alerts               Alert[]
  holidays             Holiday[]
  dayPlans             DayPlanSubmission[]
  dayClosures          DayClosureSubmission[]
  voiceInteractions    VoiceInteraction[]
  imageExtractions     ImageExtraction[]
  textInteractions     TextInteraction[]
  unifiedInteractions  UnifiedInteraction[]
}

model Task {
  id         String    @id @default(cuid())
  // Sprint 11: split `userId` into assignee + creator.
  // assigneeId — the user whose task list this lives on (does the work).
  // creatorId  — the user who created/delegated it. Equal to assigneeId for
  //               self-created tasks; different when a manager delegates.
  assigneeId String
  creatorId  String
  title      String
  targetDate DateTime  @db.Date
  priority   String?
  completed  Boolean   @default(false)
  isPartial  Boolean   @default(false)
  notes      String?
  aiFeedback String?
  sourceType String
  sourceId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  assignee User        @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creator  User        @relation("CreatedTasks", fields: [creatorId], references: [id])
  media    TaskMedia[]

  @@index([assigneeId, targetDate])
  @@index([assigneeId, deletedAt])
}

model TaskMedia {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  content   String
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String
  type        String
  source      String
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, dismissedAt])
}

model Holiday {
  userId String
  date   DateTime @db.Date
  reason String?

  user User @relation(fields: [userId], references: [id])

  @@id([userId, date])
}

model DayPlanSubmission {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  submittedAt  DateTime @default(now())
  taskSnapshot Json

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DayClosureSubmission {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date
  submittedAt DateTime @default(now())
  commentary  String
  aiFeedback  Json
  mediaIds    String[]

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model VoiceInteraction {
  id              String   @id @default(cuid())
  userId          String
  audioUrl        String?
  transcript      String
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ImageExtraction {
  id              String   @id @default(cuid())
  userId          String
  imageUrl        String?
  extractedText   String?
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model TextInteraction {
  id              String   @id @default(cuid())
  userId          String
  inputText       String
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model UnifiedInteraction {
  id              String   @id @default(cuid())
  userId          String
  inputText       String?
  audioUrl        String?
  imageUrl        String?
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
