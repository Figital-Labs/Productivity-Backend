# ----------------------------------------------------------------------------
# .env.example — copy this file to `.env` and fill in your own values.
#
# `.env` is gitignored and NEVER committed. Don't paste real credentials here.
# ----------------------------------------------------------------------------


# === Database ================================================================

# Local Postgres (Docker). Match this against the credentials you used in the
# `docker run` command from README.md. The database name (`tasklist` here)
# must already exist — the docker command creates it via POSTGRES_DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasklist"

# --- Other database targets: references for scripts/, NEVER read by app code ---------------
# The app reads ONLY `DATABASE_URL` above. Point it at whichever target you want to work against.
#
# ⚠️ SSL asymmetry, and it is easy to get wrong:
#   * `DATABASE_URL` (node-postgres/Prisma) against AWS RDS needs `?uselibpqcompat=true&sslmode=require`.
#     node-postgres 8.21+ reads a BARE `sslmode=require` as verify-full, which fails on RDS's
#     private CA (SELF_SIGNED_CERT_IN_CHAIN).
#   * The keys below must NOT carry `uselibpqcompat` — it is a node-postgres invention that real
#     libpq (psql, pg_dump, pg_restore) REJECTS, silently breaking every script in scripts/.
#
# See .agents/DATABASE-ACCESS.md for how to connect to each, and the security-group model.

# Local Postgres in Docker — used by scripts/, same value as DATABASE_URL above by default.
DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/tasklist"

# Shared AWS RDS dev database. Read by scripts/push-local-to-dev.sh (which refuses any target
# whose name doesn't contain "dev"). The instance is shared with other teams.
DATABASE_URL_DEV=""

# PRODUCTION. Read by scripts/pull-prod-to-local.sh. Requires your IP to be allowlisted on the
# prod security group, or connections HANG rather than erroring.
DATABASE_URL_PROD=""

# Retired Neon production database, kept only as a rollback snapshot after the 2026-08-24
# migration to RDS. Read by scripts/migrate-neon-to-rds.sh. Leave empty unless rolling back.
DATABASE_URL_NEON_LEGACY=""


# === Vertex AI (Google Cloud) ===============================================

# IMPORTANT: paste the FULL service account JSON on ONE line, SINGLE-QUOTED.
# This is NOT a file path. The whole JSON is the env var value.
#
# How to generate:
#   1. GCP Console → IAM & Admin → Service Accounts → Create
#   2. Grant role: roles/aiplatform.user
#   3. Keys tab → Add Key → Create new key → JSON → downloads a .json file
#   4. Open the .json file, copy its entire contents, paste between the single
#      quotes below. The newlines inside `private_key` (rendered as literal
#      `\n`) must survive — single-quoting prevents dotenv from processing
#      escape sequences.
#
# Why inline (not a file path)? PaaS portability — Render / Railway / Fly /
# Cloud Run all read env vars; none have a "mount JSON file" pattern.
# See .agents/decisions/0002-vertex-credentials.md for the full reasoning.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-gcp-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-gcp-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-gcp-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# Your GCP project ID. Must match `project_id` inside the service account JSON.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region. us-central1 has best Gemini availability + lowest latency
# for our region. Change if you have data residency requirements.
GOOGLE_CLOUD_LOCATION=us-central1

# --- Gemini model selection -------------------------------------------------
# gemini-2.5-flash RETIRES on Vertex AI in October 2026 — this must move to a
# Gemini 3.x model before then. The model is env-driven so a candidate can be
# canaried on ONE surface and rolled back without a deploy.
#
# Global default for every surface:
GEMINI_MODEL=gemini-2.5-flash
#
# Optional per-surface overrides (unset → GEMINI_MODEL). Surfaces:
#   EXTRACTION    voice / text / image personal capture
#   DELEGATION    team voice / text / image delegate
#   MEETING       meeting summarisation (long audio — the heaviest surface)
#   DAY_CLOSURE   end-of-day feedback
#   MORNING_BRIEF manager brief
#   TRANSCRIBE    verbatim audio → text
# GEMINI_MODEL_EXTRACTION=gemini-3.5-flash-lite
# GEMINI_MODEL_MEETING=gemini-3.6-flash
#
# Thinking is configured ONCE as a budget (see lib/ai-config.ts) and translated
# per model family: 2.x gets `thinkingBudget`, 3.x gets `thinkingLevel`.
#
# temperature policy. `configured` (default) uses our per-surface values, which
# keep extraction deterministic. Gemini 3 defaults to 1.0 and Google advises
# against lowering it, so `model-default` omits temperature entirely — evaluate
# both before switching a surface to a 3.x model.
# AI_TEMPERATURE_MODE=configured


# === App config =============================================================

# HTTP port the server listens on.
PORT=3000

# Environment. Affects Prisma singleton behavior + log verbosity.
# One of: development | production | test
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
# POC default allows any frontend origin. Lock this down before production.
CORS_ORIGINS=*


# === Auth ===================================================================

# JWT signing secret. Required at boot. Generate one with either:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Any jsonwebtoken duration string, e.g. 30d, 24h, 3600.
JWT_TTL=30d


# === AWS S3 — media storage (ADR-0023 / ADR-0025) ===========================

# Durable object storage for uploaded audio/images. Required at boot (validated in
# src/config/env.ts → env.s3). The AWS SDK also reads these names natively.
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-media-bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Key prefix all media is stored under: <prefix>/<orgId>/<userId>/<uuid>.<ext>
MEDIA_KEY_PREFIX=media


# === Background worker (ADR-0025) ===========================================

# Where the pg-boss consumer runs.
#   true  (default) — in the web process. One container does HTTP + job processing. Simplest.
#   false           — split it out: run `node dist/worker.js` as a SEPARATE process/container.
# When false, BE AWARE:
#   • You MUST run the worker process, or jobs enqueue and never process (no error).
#   • The Dockerfile HEALTHCHECK hits /livez (HTTP) — the worker has no HTTP server, so run the
#     worker container with the healthcheck DISABLED (e.g. `docker run --no-healthcheck`).
#   • Both processes still need DIRECT_DATABASE_URL + Vertex + S3 creds (the web side still runs the
#     SYNC AI endpoints and enqueues). Size the WORKER for RAM (≥4 GB) — that's where 90 MB meetings live.
RUN_WORKER_IN_PROCESS=true

# Per-poll batch sizes, split by queue. The queue is pg-boss on DATABASE_URL — there is NO Redis.
# Read by the worker (in-process or split). Run the worker with `npm run worker` when split.
#
# A single meeting can hold ~90 MB (+~120 MB base64) in RAM while it runs, so keep its concurrency
# LOW and size the worker box for MEETING_WORKER_CONCURRENCY × ~120 MB + headroom. Captures are
# small (≤10 MB) and stay parallel.
MEETING_WORKER_CONCURRENCY=2
CAPTURE_WORKER_CONCURRENCY=3

# Lifetime (seconds) of a presigned upload URL. Generous so a 10 MB capture finishes even on a slow
# mobile link (a short window can expire mid-upload on 2G/3G). Single-use + key-scoped → safe.
PRESIGN_UPLOAD_EXPIRY_SECONDS=900

# Per-attempt AI timeout (ms) for the async meeting worker. Sized for the p95 long meeting
# (~5–6 hr / 90 MB). The pg-boss visibility window AND the frontend poll patience derive from this,
# so this one knob tunes the whole chain. Default 800000 ≈ 13 min.
MEETING_AI_TIMEOUT_MS=800000

# pg-boss re-dispatches a job whose worker DIED (crash/OOM) up to this many times.
JOB_RETRY_LIMIT=2
