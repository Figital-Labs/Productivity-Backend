# ----------------------------------------------------------------------------
# .env.example — copy this file to `.env` and fill in your own values.
#
# `.env` is gitignored and NEVER committed. Don't paste real credentials here.
# ----------------------------------------------------------------------------


# === Database ================================================================

# Local Postgres (Docker). Match this against the credentials you used in the
# `docker run` command from README.md. The database name (`tasklist` here)
# must already exist — the docker command creates it via POSTGRES_DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tasklist"

# Optional: production database (Neon, Supabase, RDS, etc.).
# Not read by local dev. Reserved for the future deployment story.
DATABASE_URL_PROD=""


# === Vertex AI (Google Cloud) ===============================================

# IMPORTANT: paste the FULL service account JSON on ONE line, SINGLE-QUOTED.
# This is NOT a file path. The whole JSON is the env var value.
#
# How to generate:
#   1. GCP Console → IAM & Admin → Service Accounts → Create
#   2. Grant role: roles/aiplatform.user
#   3. Keys tab → Add Key → Create new key → JSON → downloads a .json file
#   4. Open the .json file, copy its entire contents, paste between the single
#      quotes below. The newlines inside `private_key` (rendered as literal
#      `\n`) must survive — single-quoting prevents dotenv from processing
#      escape sequences.
#
# Why inline (not a file path)? PaaS portability — Render / Railway / Fly /
# Cloud Run all read env vars; none have a "mount JSON file" pattern.
# See .agents/decisions/0002-vertex-credentials.md for the full reasoning.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-gcp-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-gcp-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-gcp-project-id.iam.gserviceaccount.com","universe_domain":"googleapis.com"}'

# Your GCP project ID. Must match `project_id` inside the service account JSON.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region. us-central1 has best Gemini availability + lowest latency
# for our region. Change if you have data residency requirements.
GOOGLE_CLOUD_LOCATION=us-central1


# === App config =============================================================

# HTTP port the server listens on.
PORT=3000

# Environment. Affects Prisma singleton behavior + log verbosity.
# One of: development | production | test
NODE_ENV=development


# === Stub auth (POC only) ===================================================

# Fallback user id when the `X-User-Id` request header is absent.
# In production this gets replaced by a JWT-derived session id and this var
# can be removed. For now, the seed script creates this exact user.
DEMO_USER_ID=demo-user-1
