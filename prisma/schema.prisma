// Prisma schema — see .agents/ARCHITECTURE.md for the design.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Real job title (e.g. "General Manager"), shown in the UI. role/level stay
  // internal (authz only); designation is the human-facing label.
  designation  String?
  passwordHash String
  role         String   @default("staff")
  level        Int      @default(100)
  // Sprint 18: org becomes an FK; isSuperAdmin is the cross-org root flag;
  // canManageUsers is the grantable L8 permission for the hierarchy guardrail.
  orgId          String
  isSuperAdmin   Boolean  @default(false)
  canManageUsers Boolean  @default(false)
  org            Organization @relation(fields: [orgId], references: [id])
  timezone     String   @default("Asia/Kolkata")
  // Sprint 19: per-user working hours as minutes from local midnight — the
  // window the day-timeline schedules tasks into. Defaults to 09:00–18:00.
  workStartMinute Int    @default(540)
  workEndMinute   Int    @default(1080)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Sprint 11: Task ownership split — assigneeId is who does the work,
  // creatorId is who created/delegated. For self-created tasks they're equal.
  assignedTasks Task[] @relation("AssignedTasks")
  createdTasks  Task[] @relation("CreatedTasks")

  // Sprint 11: M2M self-relation for matrix hospital authority.
  // A staff nurse can have multiple managers (Head Nurse + Attending Doctor)
  // and a manager can have multiple reports. Declared as Prisma implicit M2M;
  // join table `_UserHierarchy` has columns A (manager) and B (report).
  reports  User[] @relation("UserHierarchy")
  managers User[] @relation("UserHierarchy")

  notes               Note[]
  alerts              Alert[]
  holidays            Holiday[]
  dayPlans            DayPlanSubmission[]
  dayClosures         DayClosureSubmission[]
  voiceInteractions   VoiceInteraction[]
  imageExtractions    ImageExtraction[]
  textInteractions    TextInteraction[]
  unifiedInteractions UnifiedInteraction[]
  memberships         GroupMembership[]
  departmentsHeaded   Department[]           @relation("DepartmentHeads")
  submissionReviews   SubmissionReview[]     @relation("SubmissionReviewer")
  remindersReceived   ReminderIntent[]       @relation("ReminderTarget")
  remindersSent       ReminderIntent[]       @relation("ReminderSender")
  briefCaches         MorningBriefCache[]    @relation("MorningBriefManager")

  // Sprint 15: meetings created by this user. Attendees are stored as a
  // String[] on Meeting (no FK enforcement at the schema level) since
  // attendance is loose — see Meeting.attendeeIds.
  meetings Meeting[] @relation("UserMeetings")
}

model Task {
  id         String    @id @default(cuid())
  // Sprint 11: split `userId` into assignee + creator.
  // assigneeId — the user whose task list this lives on (does the work).
  // creatorId  — the user who created/delegated it. Equal to assigneeId for
  //               self-created tasks; different when a manager delegates.
  assigneeId String
  creatorId  String
  title      String
  targetDate DateTime  @db.Date
  // Sprint 19: intra-day time-slot scheduling. Minutes from local midnight on
  // the targetDate day (0–1439); null = Unscheduled. Duration defaults to 30
  // when scheduled. Wall-clock = targetDate (local date) + minute offset, so no
  // UTC/DST math is needed and overlap is a pure integer-interval comparison.
  scheduledStartMinute     Int?
  scheduledDurationMinutes Int?
  priority   String?
  completed  Boolean   @default(false)
  isPartial  Boolean   @default(false)
  // Sprint 20: stamped when a task transitions to completed (cleared on un-complete).
  // Gives a real "done at" signal for schedule-adherence analytics.
  completedAt DateTime?
  notes      String?
  aiFeedback String?
  sourceType String
  sourceId   String?
  groupId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  assignee User          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  creator  User          @relation("CreatedTasks", fields: [creatorId], references: [id])
  group    ContextGroup? @relation(fields: [groupId], references: [id])
  media    TaskMedia[]

  @@index([assigneeId, targetDate])
  @@index([assigneeId, deletedAt])
  @@index([groupId, targetDate])
  @@index([assigneeId, targetDate, scheduledStartMinute])
}

model TaskMedia {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  url       String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Note {
  id        String    @id @default(cuid())
  userId    String
  content   String
  archived  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, deletedAt])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String
  type        String
  source      String
  createdAt   DateTime  @default(now())
  dismissedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, dismissedAt])
}

model Holiday {
  userId String
  date   DateTime @db.Date
  reason String?

  user User @relation(fields: [userId], references: [id])

  @@id([userId, date])
}

model DayPlanSubmission {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  submittedAt  DateTime @default(now())
  taskSnapshot Json

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model DayClosureSubmission {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime  @db.Date
  // Sprint 17: two-phase closure. A row is created with status='draft' on
  // `POST /day-closure/review` (AI feedback generated once) and flipped to
  // 'submitted' on `POST /day-closure/submit`. Existing rows default to
  // 'submitted' so the migration is a no-op for already-shipped data.
  status      String    @default("submitted")
  reviewedAt  DateTime?
  submittedAt DateTime  @default(now())
  commentary  String
  aiFeedback  Json
  mediaIds    String[]

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model VoiceInteraction {
  id              String   @id @default(cuid())
  userId          String
  audioUrl        String?
  transcript      String
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model ImageExtraction {
  id              String   @id @default(cuid())
  userId          String
  imageUrl        String?
  extractedText   String?
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model TextInteraction {
  id              String   @id @default(cuid())
  userId          String
  inputText       String
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model UnifiedInteraction {
  id              String   @id @default(cuid())
  userId          String
  inputText       String?
  audioUrl        String?
  imageUrl        String?
  actions         Json
  recommendations Json
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// Sprint 15: meetings. The meeting creator is `userId`. `attendeeIds` is a
// loose String[] of User.ids (no FK enforcement at schema level — POC scope;
// service-layer validates same-org membership at create time). Audio bytes
// are never persisted; they live client-side until the user clicks Send-to-AI,
// then flow through Vertex inline. The model stores agenda, typed notes, AI
// summary, dispatched actions (PersistedMeetingAction[]), and recommendations
// — same JSON pattern as VoiceInteraction.actions etc.
model Meeting {
  id              String    @id @default(cuid())
  userId          String // creator
  title           String
  scheduledAt     DateTime
  type            String // 'hurdle' | '1-on-1' (free-form to allow future types)
  attendeeIds     String[]
  agenda          String?
  notes           String?
  summary         String?
  customPrompt    String?
  actions         Json      @default("[]") // PersistedMeetingAction[] post-process
  recommendations Json      @default("[]") // MeetingRecommendation[] post-process
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation("UserMeetings", fields: [userId], references: [id])

  @@index([userId, deletedAt])
  @@index([userId, scheduledAt])
  @@index([userId, processedAt])
}

model Department {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  headId    String?
  createdAt DateTime @default(now())

  org    Organization   @relation(fields: [orgId], references: [id])
  head   User?          @relation("DepartmentHeads", fields: [headId], references: [id])
  groups ContextGroup[]

  @@index([orgId])
}

model ContextGroup {
  id           String   @id @default(cuid())
  orgId        String
  departmentId String?
  name         String
  /// 'ward' | 'ot' | 'shift' | 'project' | 'personal'
  /// 'personal' is reserved for the Personal-Directs lazy auto-provision in Sprint 16B.
  /// Sprint 16B endpoints filter `kind: "personal"` out of the public group grid.
  kind         String   @default("ward")
  createdAt    DateTime @default(now())

  org         Organization      @relation(fields: [orgId], references: [id])
  department  Department?       @relation(fields: [departmentId], references: [id])
  memberships GroupMembership[]
  tasks       Task[]

  @@index([orgId])
  @@index([departmentId])
}

model GroupMembership {
  userId    String
  groupId   String
  isLead    Boolean   @default(false)
  canManage Boolean   @default(false)
  validFrom DateTime  @default(now())
  validTo   DateTime?
  reason    String?

  user  User         @relation(fields: [userId], references: [id])
  group ContextGroup @relation(fields: [groupId], references: [id])

  @@id([userId, groupId, validFrom])
  @@index([groupId, validTo])
  @@index([userId, validTo])
}

/// L2: matrix-aware submission review state. One row per (submission, manager).
/// `submissionKind` is "plan" | "closure" - discriminator over the two submission tables.
model SubmissionReview {
  submissionId   String
  submissionKind String
  reviewerId     String
  reviewedAt     DateTime @default(now())

  reviewer User @relation("SubmissionReviewer", fields: [reviewerId], references: [id])

  @@id([submissionId, submissionKind, reviewerId])
  @@index([reviewerId, reviewedAt])
}

/// Demo stub for Sprint 16D's "Send Reminder" button. No actual delivery.
model ReminderIntent {
  id           String   @id @default(cuid())
  targetUserId String
  /// 'plan' | 'closure'
  kind         String
  sentAt       DateTime @default(now())
  sentBy       String

  target User @relation("ReminderTarget", fields: [targetUserId], references: [id])
  sender User @relation("ReminderSender", fields: [sentBy], references: [id])

  @@index([targetUserId, sentAt])
}

model MorningBriefCache {
  managerId   String
  date        DateTime @db.Date
  payload     Json
  generatedAt DateTime @default(now())

  manager User @relation("MorningBriefManager", fields: [managerId], references: [id])

  @@id([managerId, date])
  @@index([managerId, generatedAt])
}

/// Sprint 18: tenant boundary. Every User / Department / ContextGroup carries
/// an `orgId` FK to this row. Root super-admins (`User.isSuperAdmin`) can
/// create new orgs via `POST /orgs`; everyone else is scoped to their own.
model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users       User[]
  departments Department[]
  groups      ContextGroup[]
}
